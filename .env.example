# Upstash Redis — gedeelde opslag van alle teamgegevens.
# Deze variabelen worden automatisch toegevoegd wanneer je in Vercel
# de Upstash-integratie koppelt (Storage > Upstash for Redis).
# Lokaal: maak een bestand .env.local met je eigen waarden.
UPSTASH_REDIS_REST_URL="https://xxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxxxxxxxxxx"

# Pincode voor de trainers (coachmodus). Standaard "1933" als je niets invult.
NEXT_PUBLIC_COACH_PIN="1933"
